# PKGBUILD for building on the Open Build Service.
#
# This package is not in AUR and has no committed source tarball, so the OBS
# tar_scm service packs the checkout into one. That tarball has a constant name
# rather than a versioned one, so pkgver here is free to track debian/changelog
# and a release does not require editing the OBS service as well.
#
# The repository-root PKGBUILD lists the payload files as bare local sources,
# which only resolves when makepkg runs inside the checkout, and cannot work on
# OBS.

# Maintainer: Generated from Debian package
pkgname=conky-toggle-mx
pkgver=25.7.02
pkgrel=1
pkgdesc="Simple toggle switch for conky-manager"
arch=('any')
url="https://github.com/mxlinux"
license=('LGPL3')
depends=('bash' 'procps-ng' 'sed')
optdepends=('conky: for system monitoring'
            'conky-manager: conky configuration manager')
source=("${pkgname}-source.tar")
sha256sums=('SKIP')

# tar_scm unpacks to <repository>-<versionformat>; both are fixed here.
_srcdir="${pkgname}-source"

package() {
    cd "${srcdir}/${_srcdir}"

    # Install the main script
    install -Dm755 conkytoggle.sh "${pkgdir}/usr/bin/conkytoggle.sh"

    # Install desktop files
    install -Dm644 conky-toggle.desktop "${pkgdir}/usr/share/applications/conky-toggle.desktop"
    install -Dm644 conky.desktop "${pkgdir}/usr/share/conky-toggle/conky.desktop"
}
